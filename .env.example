TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
CLAUDE_NOTIFY_WEBHOOK_SECRET=replace_with_random_64_hex_chars

# Give Claude dispatcher jobs access to the paired Claude in Chrome extension
# CLAUDE_NOTIFY_CLAUDE_CHROME=true

# Optional: ephemeral web previews. "auto" uses Cloudflare when fully
# configured, otherwise Tailscale when its CLI is installed and connected.
# CLAUDE_NOTIFY_PREVIEW_PROVIDER=auto
# CLAUDE_NOTIFY_PREVIEW_TTL_SECONDS=7200

# Cloudflare Access provider (browser access with emailed OTP)
# CLOUDFLARE_API_TOKEN=your_scoped_api_token
# CLOUDFLARE_ACCOUNT_ID=your_account_id
# CLOUDFLARE_ZONE_ID=your_zone_id
# CLOUDFLARE_PREVIEW_DOMAIN=example.com
# CLOUDFLARE_ACCESS_EMAILS=you@example.com,tester@example.com
# CLOUDFLARE_ACCESS_SESSION_DURATION=1h

# Tailscale provider. "serve" is private to your tailnet; "funnel" is public.
# TAILSCALE_PREVIEW_MODE=serve
# TAILSCALE_PATH=tailscale
# Optional: run Tailscale on an existing SSH host and reverse-forward the local app
# TAILSCALE_SSH_HOST=ssh-tron
# TAILSCALE_SSH_PATH=ssh
